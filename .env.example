# Copy this file to .env for local development. Never commit real credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Per-run compilation limits. Input budget counts prompt characters, not tokens.
LMWK_COMPILE_CONCURRENCY=3
LMWK_COMPILE_BATCH_UNITS=6
LMWK_COMPILE_BATCH_CHARS=12000
LMWK_COMPILE_MAX_RETRIES=1
LMWK_COMPILE_STREAM=true
# Seconds: connection establishment, idle network reads, entire batch request.
LMWK_COMPILE_CONNECT_TIMEOUT=20
LMWK_COMPILE_READ_TIMEOUT=180
LMWK_COMPILE_TOTAL_TIMEOUT=300
